server {
    listen 80;
    listen [::]:80;
    # Uncomment and configure SSL if using HTTPS
    # listen 443 ssl http2;
    # listen [::]:443 ssl http2;
    # ssl_certificate /etc/ssl/zizhuangjia.xyz/fullchain.pem;
    # ssl_certificate_key /etc/ssl/zizhuangjia.xyz/privkey.pem;
    # ssl_protocols TLSv1.2 TLSv1.3;
    # ssl_ciphers HIGH:!aNULL:!MD5;

    server_name www.zizhuangjia.xyz zizhuangjia.xyz;

    # Redirect www to non-www (optional, choose one)
    if ($host = zizhuangjia.xyz) {
        return 301 http://www.zizhuangjia.xyz$request_uri;
    }

    # Access and error logs
    access_log /var/log/nginx/zizhuangjia.access.log;
    error_log /var/log/nginx/zizhuangjia.error.log;

    # Proxy for admin backend
    location /admin/ {
        proxy_pass http://127.0.0.1:7001/admin/;
        proxy_set_header Host $host; # Set Host to domain only
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy for API
    location /api/v1/ {
        proxy_pass http://127.0.0.1:7001/api/;
        proxy_set_header Host $host; # Set Host to domain only
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Handle public assets (if applicable)
    location /public/ {
        proxy_pass http://127.0.0.1:7001/public/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Handle pages assets (if applicable)
    location /pages/ {
        proxy_pass http://127.0.0.1:7001/pages/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Root path (optional: redirect to /admin or serve a default page)
    location / {
        return 301 http://www.zizhuangjia.xyz/admin/;
    }
}