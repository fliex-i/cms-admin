server {
    listen 80;
    listen [::]:80;
    listen 443 ssl http2;
    # ssl_certificate /etc/ssl/zizhuangjia.xyz/fullchain.pem;
    # ssl_certificate_key /etc/ssl/zizhuangjia.xyz/privkey.pem;

    server_name www.zizhuangjia.xyz zizhuangjia.xyz;
    
    # 访问日志（可选）
    access_log /var/log/nginx/zizhuangjia.access.log;
    error_log /var/log/nginx/zizhuangjia.error.log;
    
    # 根路径代理配置
    location / {
        proxy_pass http://127.0.0.1:7001/admin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
    }
    location /api {
        proxy_pass http://127.0.0.1:7001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
    }  
}