{
  "type": "page",
  "css": {},
  "body": [
    {
      "type": "crud",
      "draggable": true,
      "name": "materialsList",
      "id": "materialsList",
      "api": "/admin/cms/materials/index",
      "saveOrderApi": "/admin/cms/materials/saveOrder",
      "perPageAvailable": [5, 10, 20, 50, 100],
      "filter": {
        "title": "材料商管理",
        "body": [
          { "type": "input-text", "name": "name", "label": "商家名称", "clearable": true, "placeholder": "通过名称搜索", "size": "sm" },
          { "type": "input-text", "name": "contact", "label": "联系人", "clearable": true, "placeholder": "通过联系人搜索", "size": "sm" },
          { "type": "input-text", "name": "phone", "label": "联系电话", "clearable": true, "placeholder": "通过电话搜索", "size": "sm" },
          { "type": "select", "name": "type", "label": "商家类型", "clearable": true, "placeholder": "请选择类型", "size": "sm", "source": "/admin/cms/materials/types", "searchable": true }
        ],
        "actions": [
          { "type": "reset", "label": "重置" },
          { "type": "submit", "level": "primary", "label": "查询" }
        ]
      },
      "filterTogglable": true,
      "headerToolbar": [
        { "type": "columns-toggler", "align": "left" },
        { "type": "drag-toggler", "align": "left" },
        "bulkActions",
        { "type": "filter-toggler", "align": "right" },
        { "type": "reload", "align": "right" },
        { "type": "button", "actionType": "drawer", "label": "新增材料商", "primary": true, "align": "right", "drawer": {
          "title": "新增材料商",
          "size": "md",
          "body": {
            "type": "form",
            "debug": false,
            "mode": "normal",
            "horizontal": { "leftFixed": "xs" },
            "api": "/admin/cms/materials/create",
            "body": [
              { "type": "input-text", "name": "name", "label": "商家名称", "required": true },
              { "type": "input-text", "name": "contact", "label": "联系人", "required": true },
              { "type": "input-text", "name": "phone", "label": "联系电话", "required": true },
              { "type": "select", "name": "type", "label": "商家类型", "required": true, "source": "/admin/cms/materials/types", "searchable": true, "clearable": true },
              { "type": "input-text", "name": "address", "label": "地址" },
              { "type": "input-text", "name": "weixin", "label": "微信号" },
              { "type": "select", "name": "region", "label": "服务区域", "options": [
                { "label": "达州市区", "value": "1" },
                { "label": "开江", "value": "2" },
                { "label": "宣汉", "value": "3" },
                { "label": "渠县", "value": "4" },
                { "label": "万源", "value": "5" },
                { "label": "大竹", "value": "6" }
              ]},
              { "type": "input-image", "name": "thumb", "label": "商家Logo", "maxLength": 1, "receiver": "/upload/adminToken" },
              { "type": "input-image", "name": "photos", "label": "店内照片", "maxLength": 5, "receiver": "/upload/adminToken", "multiple": true },
              { "type": "textarea", "name": "desc", "label": "商家介绍", "maxLength": 800 }
            ]
          }
        } }
      ],
      "bulkActions": [
        { "label": "批量删除", "actionType": "ajax", "api": "/admin/cms/materials/bulkDel", "confirmText": "确定要批量删除?" }
      ],
      "footerToolbar": ["switch-per-page", "statistics", "pagination"],
      "paginationMode": "simple",
      "columns": [
        { "name": "id", "label": "ID", "width": 20, "sortable": true, "type": "text", "toggled": true },
        { "label": "Logo", "type": "image", "name": "thumb", "className": "tdimg" },
        { "name": "name", "label": "商家名称", "type": "text", "toggled": true },
        { "name": "contact", "label": "联系人", "type": "text", "toggled": true },
        { "name": "phone", "label": "联系电话", "type": "text", "toggled": true },
        { "name": "address", "label": "地址", "type": "text", "toggled": true },
        { "name": "weixin", "label": "微信号", "type": "text", "toggled": true },
        { "type": "select", "name": "region", "label": "服务区域", "toggled": true, "options": [
          { "label": "达州市区", "value": "1" },
                { "label": "开江", "value": "2" },
                { "label": "宣汉", "value": "3" },
                { "label": "渠县", "value": "4" },
                { "label": "万源", "value": "5" },
                { "label": "大竹", "value": "6" }
        ]},
        { "name": "desc", "label": "介绍", "type": "text", "toggled": true },
        { "name": "createdAt", "label": "创建时间", "type": "date", "toggled": true, "format": "YYYY-MM-DD HH:mm" },
        { "name": "updatedAt", "label": "更新时间", "type": "date", "toggled": true, "format": "YYYY-MM-DD HH:mm" },
        { "type": "operation", "label": "操作", "width": 80, "buttons": [
          { "type": "button", "icon": "fa fa-pencil", "actionType": "drawer", "drawer": {
            "title": "编辑材料商",
            "size": "md",
            "body": {
              "type": "form",
              "debug": false,
              "mode": "normal",
              "horizontal": { "leftFixed": "xs" },
              "api": "/admin/cms/materials/update",
              "body": [
                { "type": "hidden", "name": "id" },
                { "type": "input-text", "name": "name", "label": "商家名称", "required": true },
                { "type": "input-text", "name": "contact", "label": "联系人", "required": true },
                { "type": "input-text", "name": "phone", "label": "联系电话", "required": true },
                { "type": "select", "name": "type", "label": "商家类型", "required": true, "source": "/admin/cms/materials/types", "searchable": true, "clearable": true },
                { "type": "input-text", "name": "address", "label": "地址" },
                { "type": "input-text", "name": "weixin", "label": "微信号" },
                { "type": "select", "name": "region", "label": "服务区域", "options": [
                  { "label": "达州市区", "value": "1" },
                { "label": "开江", "value": "2" },
                { "label": "宣汉", "value": "3" },
                { "label": "渠县", "value": "4" },
                { "label": "万源", "value": "5" },
                { "label": "大竹", "value": "6" }
                ]},
                { "type": "input-image", "name": "thumb", "label": "商家Logo", "maxLength": 1, "receiver": "/upload/adminToken" },
                {
                  "type": "input-image",
                  "name": "photos",
                  "label": "店内照片",
                  "maxLength": 5,
                  "multiple": true,
                  "receiver": "/upload/adminToken",
                  "addButtonText": "新增照片"
                },
                { "type": "textarea", "name": "desc", "label": "商家介绍", "maxLength": 800 }
              ]
            }
          } },
          { "type": "button", "icon": "fa fa-times text-danger", "actionType": "ajax", "confirmText": "您确认要删除?", "api": "/admin/cms/materials/destroy?id=$id" }
        ], "toggled": true }
      ]
    }
  ]
}
