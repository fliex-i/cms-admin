{
  "type": "page",
  "body": [
    {
      "type": "crud",
      "name": "processList",
      "api": "/admin/sys/process/index",
      "saveOrderApi": "/admin/sys/process/saveOrder",
      "filter": {
        "title": "工艺标准管理",
        "body": [
          { "type": "input-text", "name": "process", "label": "流程介绍", "clearable": true },
          { "type": "input-text", "name": "standard", "label": "工艺标准", "clearable": true },
          { "type": "input-text", "name": "type", "label": "施工类型", "clearable": true },
          { "type": "input-text", "name": "notes", "label": "注意事项", "clearable": true },
          { "type": "input-text", "name": "key", "label": "关联项目key", "clearable": true }
        ],
        "actions": [
          { "type": "reset", "label": "重置" },
          { "type": "submit", "level": "primary", "label": "查询" }
        ]
      },
      "headerToolbar": [
        "bulkActions",
        { "type": "button", "actionType": "drawer", "label": "新增工艺标准", "primary": true, "drawer": {
          "title": "新增工艺标准",
          "body": {
            "type": "form",
            "api": "/admin/sys/process/create",
            "body": [
              { "type": "input-text", "name": "process", "label": "流程介绍", "required": true },
              { "type": "input-text", "name": "standard", "label": "工艺标准", "required": true },
              { "type": "input-text", "name": "type", "label": "施工类型" },
              { "type": "input-text", "name": "notes", "label": "注意事项" },
              { "type": "input-text", "name": "key", "label": "关联项目key" }
            ]
          }
        }}
      ],
      "bulkActions": [
        { "label": "批量删除", "actionType": "ajax", "api": "/admin/sys/process/bulkDel", "confirmText": "确定要批量删除?" }
      ],
      "columns": [
        { "name": "id", "label": "ID", "type": "text", "sortable": true },
        { "name": "process", "label": "流程介绍", "type": "text" },
        { "name": "standard", "label": "工艺标准", "type": "text" },
        { "name": "type", "label": "施工类型", "type": "text" },
        { "name": "notes", "label": "注意事项", "type": "text" },
        { "name": "key", "label": "关联项目key", "type": "text" },
        { "name": "createdAt", "label": "创建时间", "type": "date", "format": "YYYY-MM-DD HH:mm" },
        { "name": "updatedAt", "label": "更新时间", "type": "date", "format": "YYYY-MM-DD HH:mm" },
        { "type": "operation", "label": "操作", "buttons": [
          { "type": "button", "icon": "fa fa-pencil", "actionType": "drawer", "drawer": {
            "title": "编辑工艺标准",
            "body": {
              "type": "form",
              "api": "/admin/sys/process/update",
              "body": [
                { "type": "hidden", "name": "id" },
                { "type": "input-text", "name": "process", "label": "流程介绍", "required": true },
                { "type": "input-text", "name": "standard", "label": "工艺标准", "required": true },
                { "type": "input-text", "name": "type", "label": "施工类型" },
                { "type": "input-text", "name": "notes", "label": "注意事项" },
                { "type": "input-text", "name": "key", "label": "关联项目key" }
              ]
            }
          }},
          { "type": "button", "icon": "fa fa-times text-danger", "actionType": "ajax", "confirmText": "您确认要删除?", "api": "/admin/sys/process/destroy?id=$id" }
        ]}
      ]
    }
  ]
}
