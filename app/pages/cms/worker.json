{
  "type": "page",
  "css": {},
  "body": [
    {
      "type": "crud",
      "draggable": true,
      "name": "workerList",
      "id": "workerList",
      "api": "/admin/cms/worker/index",
      "saveOrderApi": "/admin/cms/worker/saveOrder",
      "perPageAvailable": [5, 10, 20, 50, 100],
      "filter": {
        "title": "工人管理",
        "body": [
          { "type": "input-text", "name": "name", "label": "姓名", "clearable": true, "placeholder": "通过姓名搜索", "size": "sm" },
          { "type": "input-text", "name": "phone", "label": "手机号", "clearable": true, "placeholder": "通过手机号搜索", "size": "sm" },
          {  "name": "workType", "label": "工种",  "type": "select",
          "toggled": true,
          "source": "/api/cms/worker/types", 
          "searchable": true,
          "clearable": true, "placeholder": "通过工种搜索", "size": "sm" }
        ],
        "actions": [
          { "type": "reset", "label": "重置" },
          { "type": "submit", "level": "primary", "label": "查询" }
        ]
      },
      "filterTogglable": true,
      "headerToolbar": [
        { "type": "columns-toggler", "align": "left" },
        { "type": "drag-toggler", "align": "left" },
        "bulkActions",
        { "type": "filter-toggler", "align": "right" },
        { "type": "reload", "align": "right" },
        { "type": "button", "actionType": "drawer", "label": "新增工人", "primary": true, "align": "right", "drawer": {
          "title": "新增工人",
          "size": "md",
          "body": {
            "type": "form",
            "debug": false,
            "mode": "normal",
            "horizontal": { "leftFixed": "xs" },
            "api": "/admin/cms/worker/create",
            "body": [
              { "type": "input-text", "name": "name", "label": "姓名", "required": true },
              { "type": "input-text", "name": "phone", "label": "手机号", "maxLength": 11, "required": true, "validations": { "isMobile": true }, "validationErrors": { "isMobile": "请输入正确的手机号" } },
              {"name": "workType",
          "label": "工种",
          "type": "select",
          "toggled": true,
          "source": "/api/cms/worker/types", 
          "searchable": true,
          "clearable": true, "required":true},
          { "type": "select", "name": "region", "label": "服务区域", "toggled": true, "options": [
          { "label": "达州市区", "value": "1" },
          { "label": "开江", "value": "2" },
          { "label": "宣汉", "value": "3" },
          { "label": "渠县", "value": "4" },
          { "label": "万源", "value": "5" },
          { "label": "大竹", "value": "6" }
]},
              { "type": "input-image", "name": "avatar", "label": "工人照片", "maxLength": 1, "receiver": "/upload/adminToken" },
              { "type": "textarea", "name": "desc", "label": "工人介绍", "maxLength": 800 },
              { "type": "input-image", "name": "case", "label": "施工案例图片", "maxLength": 6, "receiver": "/upload/adminToken", "multiple": true,"addButtonText": "新增照片" },
              { "type": "input-text", "name": "weixin", "label": "微信号", "maxLength": 32 },
              { "type": "input-tag", "name": "tags", "label": "标签", "placeholder": "请输入标签，回车分隔" }
            ]
          }
        } }
      ],
      "bulkActions": [
        { "label": "批量删除", "actionType": "ajax", "api": "/admin/cms/worker/bulkDel", "confirmText": "确定要批量删除?" }
      ],
      "footerToolbar": ["switch-per-page", "statistics", "pagination"],
      "paginationMode": "simple",
      "columns": [
        { "name": "id", "label": "ID", "width": 20, "sortable": true, "type": "text", "toggled": true },
        { "label": "照片", "type": "image", "name": "avatar", "className": "tdimg" },
        { "name": "name", "label": "姓名", "type": "text", "toggled": true },
        { "name": "phone", "label": "手机号", "type": "text", "maxLength": 11, "toggled": true },
        {
          "name": "workType",
          "label": "工种",
          "type": "select",
          "toggled": true,
          "source": "/api/cms/worker/types", 
          "searchable": true,
          "clearable": true
        },
        { "type": "select", "name": "region", "label": "服务区域", "toggled": true, "options": [
  { "label": "达州市区", "value": "1" },
                { "label": "开江", "value": "2" },
                { "label": "宣汉", "value": "3" },
                { "label": "渠县", "value": "4" },
                { "label": "万源", "value": "5" },
                { "label": "大竹", "value": "6" }
]},
        { "name": "desc", "label": "介绍", "type": "text", "toggled": true },
        { "name": "createdAt", "label": "创建时间", "type": "date", "toggled": true, "format": "YYYY-MM-DD HH:mm" },
        { "name": "updatedAt", "label": "更新时间", "type": "date", "toggled": true, "format": "YYYY-MM-DD HH:mm" },
        { "name": "weixin", "label": "微信号", "type": "text", "maxLength": 32, "toggled": true },
        { "name": "tags", "label": "标签", "type": "text", "toggled": true },
        { "type": "operation", "label": "操作", "width": 80, "buttons": [
          { "type": "button", "icon": "fa fa-pencil", "actionType": "drawer", "drawer": {
            "title": "编辑工人",
            "size": "md",
            "body": {
              "type": "form",
              "debug": false,
              "mode": "normal",
              "horizontal": { "leftFixed": "xs" },
              "api": "/admin/cms/worker/update",
              "body": [
                { "type": "hidden", "name": "id" },
                { "type": "input-text", "name": "name", "label": "姓名", "required": true },
                { "type": "input-text", "name": "phone", "label": "手机号", "maxLength": 11, "required": true},
                {"name": "workType",
          "label": "工种",
          "type": "select",
          "toggled": true,
          "source": "/api/cms/worker/types", 
          "searchable": true,
          "clearable": true, "required":true},
          { "type": "select", "name": "region", "label": "服务区域", "toggled": true, "options": [
  { "label": "达州市区", "value": "1" },
                { "label": "开江", "value": "2" },
                { "label": "宣汉", "value": "3" },
                { "label": "渠县", "value": "4" },
                { "label": "万源", "value": "5" },
                { "label": "大竹", "value": "6" }
]},
                { "type": "input-image", "name": "avatar", "label": "工人照片", "maxLength": 1, "receiver": "/upload/adminToken" },
                { "type": "textarea", "name": "desc", "label": "工人介绍", "maxLength": 800 },
                { "type": "input-image", "name": "case", "label": "施工案例图片", "maxLength": 6, "receiver": "/upload/adminToken", "multiple": true,"addButtonText": "新增照片" },
                { "type": "input-text", "name": "weixin", "label": "微信号", "maxLength": 32 },
                { "type": "input-tag", "name": "tags", "label": "标签", "placeholder": "请输入标签，回车分隔" }
              ]
            }
          } },
          { "type": "button", "icon": "fa fa-times text-danger", "actionType": "ajax", "confirmText": "您确认要删除?", "api": "/admin/cms/worker/destroy?id=$id" }
        ], "toggled": true }
      ]
    }
  ]
}
