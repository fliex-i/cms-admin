{
  "type": "page",
  "title": "商家类型管理",
  "body": [
    {
      "type": "crud",
      "name": "materialsTypesList",
      "api": "/api/cms/material_types",
      "filter": {
        "title": "类型筛选",
        "body": [
          { "type": "input-text", "name": "name", "label": "类型名称" }
        ],
        "actions": [
          { "type": "reset", "label": "重置" },
          { "type": "submit", "level": "primary", "label": "查询" }
        ]
      },
      "headerToolbar": [
        "bulkActions",
        { "type": "button", "actionType": "drawer", "label": "新增类型", "primary": true, "drawer": {
          "title": "新增类型",
          "body": {
            "type": "form",
            "api": "/api/cms/material_types/create",
            "body": [
              { "type": "input-text", "name": "name", "label": "类型名称", "required": true },
              { "type": "textarea", "name": "desc", "label": "类型描述" }
            ]
          }
        }}
      ],
      "bulkActions": [
        { "label": "批量删除", "actionType": "ajax", "api": "/api/cms/material_types/bulkDel", "confirmText": "确定要批量删除?" }
      ],
      "columns": [
        { "name": "id", "label": "ID", "type": "text", "sortable": true },
        { "name": "name", "label": "类型名称", "type": "text" },
        { "name": "desc", "label": "类型描述", "type": "text" },
        { "name": "createdAt", "label": "创建时间", "type": "date", "format": "YYYY-MM-DD HH:mm" },
        { "name": "updatedAt", "label": "更新时间", "type": "date", "format": "YYYY-MM-DD HH:mm" },
        { "type": "operation", "label": "操作", "buttons": [
          { "type": "button", "icon": "fa fa-pencil", "actionType": "drawer", "drawer": {
            "title": "编辑类型",
            "body": {
              "type": "form",
              "api": "/api/cms/material_types/update",
              "body": [
                { "type": "hidden", "name": "id" },
                { "type": "input-text", "name": "name", "label": "类型名称", "required": true },
                { "type": "textarea", "name": "desc", "label": "类型描述" }
              ]
            }
          }},
          { "type": "button", "icon": "fa fa-times text-danger", "actionType": "ajax", "confirmText": "您确认要删除?", "api": "/api/cms/material_types/destroy?id=$id" }
        ]}
      ]
    }
  ]
}
