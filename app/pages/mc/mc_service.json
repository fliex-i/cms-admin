{
  "type": "page",
  "title": "咨询回复管理",
  "body": [
    {
      "type": "crud",
      "name": "mcServiceList",
      "api": "/admin/mc/mc_service/list",
      "filter": {
        "title": "筛选",
        "body": [
            { "type": "input-text", "name": "member.username", "label": "用户名", "clearable": true },
          { "type": "input-text", "name": "message", "label": "咨询内容", "clearable": true }
        ],
        "actions": [
          { "type": "reset", "label": "重置" },
          { "type": "submit", "level": "primary", "label": "查询" }
        ]
      },
      "headerToolbar": ["bulkActions", { "type": "reload" }],
      "footerToolbar": ["switch-per-page", "statistics", "pagination"],
      "paginationMode": "simple",
      "columns": [
        { "name": "id", "label": "ID", "type": "text", "sortable": true },
        { "name": "member.username", "label": "用户名", "type": "text" },
        { "name": "message", "label": "咨询内容", "type": "text" },
        { "name": "response", "label": "管理员回复", "type": "text" },
        { "name": "createdAt", "label": "创建时间", "type": "datetime" },
        {
          "name": "updatedAt",
          "label": "回复时间",
          "type": "text",
          "format":"YYYY-MM-DD HH:mm",
          "tpl": "${response ? date(updatedAt * 1000) : '--'}"
        },
        {
          "type": "operation",
          "label": "操作",
          "buttons": [
            {
              "type": "button",
              "icon": "fa fa-reply",
              "actionType": "drawer",
              "drawer": {
                "title": "回复咨询",
                "body": {
                  "type": "form",
                  "api": {
                    "method": "post",
                    "url": "/api/mc/service/replay",
                    "data": {
                      "id": "${id}",
                      "response": "${response}"
                    }
                  },
                  "mode": "inline",
                  "controls": [
                    { "type": "static", "name": "message", "label": "咨询内容" },
                    { "type": "static", "name": "member.id", "label": "用户ID" },
                    { "type": "static", "name": "member.username", "label": "用户名称" },
                    { "type": "textarea", "name": "response", "label": "管理员回复", "required": true },
                    { "type": "submit", "label": "保存", "level": "primary" }
                  ]
                }
              }
            },
            {
              "type": "button",
              "icon": "fa fa-times text-danger",
              "actionType": "ajax",
              "confirmText": "您确认要删除?",
              "api": {
                "method":"post",
                "url":"/api/mc/service/destroy",
                "data": {"id":"${id}"}
              }
            }
          ]
        }
      ]
    }
  ]
}
