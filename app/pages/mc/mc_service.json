{
  "type": "page",
  "title": "咨询回复管理",
  "body": [
    {
      "type": "crud",
      "name": "mcServiceList",
      "api": "/admin/mc/mc_service/sysList",
      "filter": {
        "title": "筛选",
        "body": [
            { "type": "input-text", "name": "member.username", "label": "用户名", "clearable": true },
          { "type": "input-text", "name": "message", "label": "咨询内容", "clearable": true }
        ],
        "actions": [
          { "type": "reset", "label": "重置" },
          { "type": "submit", "level": "primary", "label": "查询" }
        ]
      },
      "headerToolbar": ["bulkActions", { "type": "reload" }],
      "footerToolbar": ["switch-per-page", "statistics", "pagination"],
      "paginationMode": "simple",
      "columns": [
        { "name": "member.username", "label": "用户名", "type": "text" },
        { "name": "member.mobile", "label": "手机号", "type": "text" },
        { "name": "last.message", "label": "咨询内容", "type": "text" },
        { "name": "last.response", "label": "管理员回复", "type": "text" },
        { "name": "last.createdAt", "label": "创建时间", "type": "datetime" },
        {
          "name": "last.updatedAt",
          "label": "回复时间",
          "type": "datetime"
        },
        {
          "type": "operation",
          "label": "操作",
          "buttons": [
            {
              "type": "button",
              "icon": "fa fa-reply",
              "actionType": "drawer",
              "drawer": {
                "title": "回复咨询",
                "body": {
                  "type": "crud",
                  "api": "/admin/mc/mc_service/list?uid=${member.id}",
                  "columns": [
                    { "name": "id", "label": "ID", "type": "text" },
                    { "name": "member.username", "label": "用户名", "type": "text" },
                    { "name": "message", "label": "咨询内容", "type": "text" },
                    { "name": "response", "label": "管理员回复", "type": "text" },
                    { "name": "createdAt", "label": "创建时间", "type": "datetime" },
                    {
                      "type": "operation",
                      "label": "操作",
                      "buttons": [
                        {
                          "type": "button",
                          "label": "回复",
                          "actionType": "drawer",
                          "drawer": {
                            "title": "回复具体咨询",
                            "size": "sm",
                            "body": {
                              "type": "form",
                              "api": {
                                "method": "post",
                                "url": "/api/mc/service/replay",
                                "data": { "id": "${id}", "response": "${response}" }
                              },
                              "feedback": {
                                "success": "回复成功",
                                "reload": "mcServiceList"
                              },
                              "controls": [
                                { "type": "static", "name": "message", "label": "咨询内容" },
                                { "type": "textarea", "name": "response", "label": "管理员回复", "required": true },
                                { "type": "submit", "label": "保存", "level": "primary" }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "icon": "fa fa-times text-danger",
              "actionType": "ajax",
              "confirmText": "您确认要删除?",
              "api": {
                "method":"post",
                "url":"/api/mc/service/destroy",
                "data": {"id":"${id}"}
              }
            }
          ]
        }
      ]
    }
  ]
}
